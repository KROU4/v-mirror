{
  "name": "v-mirror",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Генератор настроек внешности V (Cyberpunk 2077 2.5) по фотографии",
  "scripts": {
    "predev": "node tools/setup-assets.mjs",
    "dev": "vite",
    "prebuild": "node tools/setup-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "catalog": "python -I tools/extract/build_catalog.py --out src/data --work"
  },
  "dependencies": {
    "@fontsource-variable/tektur": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
